# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — never commit real secrets.

# --- Sanity (server-side only — never exposed to the browser) ---
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
# Token with write access, used by the API routes, migration script and studio.
SANITY_API_TOKEN=your-sanity-api-token
SANITY_API_VERSION=2024-06-01

# --- Sanity (public — safe to expose; used by client image URLs) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# --- Contact ---
WHATSAPP_NUMBER=8801781685200
SHOP_PHONE=+8801781685200
